PORT=3001

# Token de verificacion del webhook de WhatsApp (Meta Cloud API).
# Lo inventas vos y tiene que coincidir con el que cargues en el panel de Meta.
META_VERIFY_TOKEN=inventar-un-token-largo

# Clave del panel web. Sin esto el panel queda deshabilitado.
# Usar algo largo y aleatorio: el link es lo unico que protege los datos.
PANEL_CLAVE=cambiar-por-algo-largo-y-aleatorio

# Donde se guarda relevamientos.xlsx.
# En Railway se define solo (RAILWAY_VOLUME_MOUNT_PATH) al montar un volumen.
# En local, si no se define, usa ./data
# DATA_DIR=./data

# Zona horaria del relevamiento. Railway corre en UTC, asi que sin esto las
# horas saldrian adelantadas. Por defecto: America/Argentina/Buenos_Aires
# ZONA_HORARIA=America/Argentina/Buenos_Aires

# Hora en que arranca la jornada comercial (0-23). Por defecto 6.
# Los locales cierran entre las 3 y las 4 AM, asi que una carga a las 02:00
# pertenece al dia que empezo la manana anterior. Con el corte en 6, la
# jornada va de las 06:00 de un dia a las 05:59 del siguiente.
# HORA_CORTE_JORNADA=6
